			<ee:message>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="updateQuery" ><![CDATA[%dw 2.0
output application/java

var columns = payload mapObject {
	"Query" : $$ ++ " =:" ++ $$
} pluck $ joinBy ","

---
"UPDATE CUSTOMERS SET " ++ columns ++ " WHERE id = " ++ vars.id as String]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
