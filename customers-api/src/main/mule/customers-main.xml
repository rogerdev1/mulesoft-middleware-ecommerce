			<db:sql ><![CDATA[INSERT INTO CUSTOMERS( 
	name,  document,  birthdate,  street,  number,  complement,  neighborhood,  postalcode,  city,  state,  country)
VALUES(
	:name,  :document,  :birthdate,  :street,  :number,  :complement,  :neighborhood,  :postalcode,  :city,  :state,  :country)]]></db:sql>
			<db:input-parameters ><![CDATA[#[payload]]]></db:input-parameters>
