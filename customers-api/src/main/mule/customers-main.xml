	<flow name="get-customers" doc:id="048a0479-472e-4bc5-aabe-05a10b3f9a8f" >
		<ee:transform doc:name="Set params" doc:id="08c0e4cb-4133-4526-9ef3-9002e0c9363f" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="params" ><![CDATA[%dw 2.0
output application/java
var params   = attributes.queryParams
var document = params.document default vars.document
var id       = params.id default vars.id
var query    = "SELECT * FROM CUSTOMERS"
fun queryByParam() = if(!isEmpty(document)) query ++ " WHERE DOCUMENT = '" ++ document as String ++ "'"
					 else if(!isEmpty(id))  query ++ ' WHERE ID = ' ++ id as String
					 else query
---
{
	document: document,
	id: id,
	query: queryByParam()
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
